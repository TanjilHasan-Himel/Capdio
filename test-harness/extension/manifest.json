{
  "manifest_version": 3,
  "name": "Capdio — Screen Recorder (Harness)",
  "version": "0.1.0",
  "description": "Capdio — Capture everything. Miss nothing. Privacy-first screen recording workspace.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "OpenCapture Spike"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
