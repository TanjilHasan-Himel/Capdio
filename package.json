{
  "name": "capdio",
  "version": "0.1.0",
  "description": "Capdio — Privacy-first screen recording workspace built for capturing, managing, and editing high-quality recordings—right from your browser.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "node scripts/build-extension.js",
    "typecheck": "tsc --noEmit",
    "test:unit": "node tests/unit/message-bus.test.js && node tests/unit/state-machine.test.js && node tests/unit/codec-detection.test.js && node tests/unit/manifest-migration.test.js && node tests/unit/chunk-storage.test.js && node tests/unit/quota-monitor.test.js",
    "test:codec": "node test-harness/test-codec-fallback.js",
    "test:audio": "node test-harness/test-audio-routing.js",
    "test:controls": "node test-harness/test-recording-controls.js",
    "test:source-closure": "node test-harness/test-source-closure.js",
    "test:migration": "node test-harness/test-manifest-storage-migration.js",
    "test:chunks": "node test-harness/test-chunk-persistence.js",
    "test:quota": "node test-harness/test-storage-quota.js",
    "test:smoke": "node test-harness/test-apps-extension-smoke.js",
    "test:tab-capture": "node test-harness/test-apps-tab-capture.js",
    "test:screen-capture": "node test-harness/test-apps-screen-capture.js",
    "test:security": "node test-harness/test-security-boundaries.js",
    "spike:ocs-002": "node test-harness/test-action-click.js",
    "benchmark:ocs-003": "node test-harness/test-60s-harness.js",
    "test:gate-g1": "node test-harness/test-gate-g1-verification.js",
    "test": "npm run typecheck && npm run test:unit && npm run test:smoke"
  },
  "keywords": [
    "screen-recorder",
    "chrome-extension",
    "tab-capture",
    "4k-recording",
    "audio-recording",
    "privacy-first"
  ],
  "author": "Tanjil Hasan",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.16.0",
    "typescript": "^7.0.2"
  }
}
