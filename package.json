{
  "name": "capdio",
  "version": "0.1.0",
  "description": "Capdio — Privacy-first screen recording workspace built for capturing, managing, and editing high-quality recordings—right from your browser.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "node scripts/build-extension.js",
    "typecheck": "tsc --noEmit",
    "test:unit": "node tests/unit/message-bus.test.js && node tests/unit/state-machine.test.js",
    "test:smoke": "node test-harness/test-apps-extension-smoke.js",
    "test:security": "node test-harness/test-security-boundaries.js",
    "spike:ocs-002": "node test-harness/test-action-click.js",
    "benchmark:ocs-003": "node test-harness/test-60s-harness.js",
    "test": "npm run typecheck && npm run test:unit && npm run test:smoke"
  },
  "keywords": [
    "screen-recorder",
    "chrome-extension",
    "tab-capture",
    "4k-recording",
    "audio-recording",
    "privacy-first"
  ],
  "author": "Tanjil Hasan",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.16.0",
    "typescript": "^7.0.2"
  }
}
